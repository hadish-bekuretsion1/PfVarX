#!/usr/bin/env python3
"""Select the locked environment recorded by bootstrap; `tool` runs an installed utility."""

import json
import os
import shutil
import sys
from pathlib import Path

root = Path(__file__).resolve().parent
if Path.cwd().resolve() != root:
    sys.exit("Run ./pfvarx from the workspace root: " + str(root))
config = root / "config/installation.json"
env = json.loads(config.read_text())["environment"] if config.exists() else "default"
args = sys.argv[1:]
command = args[1:] if args and args[0] == "tool" else ["pfvarx", *args]
if not shutil.which("pixi"):
    sys.exit("Pixi is not on PATH; install the reviewed Pixi version before using this launcher")
os.execvp("pixi", ["pixi", "run", "--locked", "-e", env, *command])
